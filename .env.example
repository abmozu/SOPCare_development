# Use a different Neon branch connection string in each environment.
# Never commit a real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_ENV=development
SOPCARE_ENABLE_DEV_SEED=true

# Prototype authentication only. Store real values as protected secrets.
SOPCARE_MOCK_PASSWORD=replace-with-a-strong-development-password
SOPCARE_SESSION_SECRET=replace-with-at-least-32-random-bytes
